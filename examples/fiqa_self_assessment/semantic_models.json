    "measures": [
      {
        "name": "Objects Assessed",
        "description": "Total number of semantic models, reports, and data agents assessed in the selected run.",
        "expression": "COUNTROWS(MartObjectReadiness)",
        "synonyms": ["assessed objects", "objects", "inventory"],
        "hidden": false
      },
      {
        "name": "Avg Score",
        "description": "Average readiness score for the selected objects. Always interpret with confidence and coverage.",
        "expression": "AVERAGE(MartObjectReadiness[score])",
        "synonyms": ["average score", "readiness score", "score"],
        "hidden": false
      },
      {
        "name": "Eligible %",
        "description": "Share of selected objects without blocking findings and therefore structurally eligible.",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(MartObjectReadiness), MartObjectReadiness[eligible] = TRUE()), COUNTROWS(MartObjectReadiness))",
        "synonyms": ["eligibility rate", "eligible percent", "eligible percentage"],
        "hidden": false
      },
      {
        "name": "Avg Confidence",
        "description": "Average confidence for selected readiness scorecards. Low confidence means evidence gaps remain.",
        "expression": "AVERAGE(MartObjectReadiness[confidence])",
        "synonyms": ["average confidence", "confidence", "evidence confidence"],
        "hidden": false
      },
      {
        "name": "Blocking Findings",
        "description": "Count of blocking findings. Any blocking finding prevents the affected object from being eligible.",
        "expression": "COUNTROWS(MartBlockingFindings)",
        "synonyms": ["blockers", "blocking issues", "eligibility blockers"],
        "hidden": false
      },
      {
        "name": "Backlog Items",
        "description": "Number of remediation backlog items generated from failed readiness checks.",
        "expression": "COUNTROWS(MartRemediationBacklog)",
        "synonyms": ["remediation items", "backlog", "actions"],
        "hidden": false
      }
