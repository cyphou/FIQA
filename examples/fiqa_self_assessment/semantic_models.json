        "name": "MartTenantReadiness",
        "role": "dimension",
        "description": "One row per assessed tenant, per run. The overall Fabric IQ and Copilot readiness scorecard at tenant level.",
        "is_date_table": false
      },
      {
        "name": "MartWorkspaceReadiness",
        "role": "dimension",
        "description": "One row per assessed workspace, per run. Readiness scorecard for a single Fabric or Power BI workspace.",
        "is_date_table": false
      },
      {
        "name": "MartObjectReadiness",
        "role": "fact",
        "description": "One row per assessed semantic model, report, or data agent, per run. Object-level readiness scorecard.",
        "is_date_table": false
      },
      {
        "name": "MartBlockingFindings",
        "role": "fact",
        "description": "One row per blocking finding raised during a run. These must be fixed before an object is eligible.",
        "is_date_table": false
      },
      {
        "name": "MartRemediationBacklog",
        "role": "fact",
        "description": "One row per prioritized remediation action across all findings in a run, grouped by owner role.",
        "is_date_table": false
      },
      {
        "name": "MartRemediationBurnDown",
        "role": "fact",
        "description": "One row per remediation lifecycle comparison for the current run. Tracks new, open, resolved, reopened and priority-changed work.",
        "is_date_table": false
      },
      {
        "name": "MartCoverageAndFreshness",
        "role": "fact",
        "description": "One row per assessed object, per run. Shows evidence coverage and confidence for the readiness score.",
        "is_date_table": false
      },
      {
        "name": "MartRunTrend",
        "role": "fact",
        "description": "One row per object compared between a baseline and current run. Separates true regressions from coverage loss.",
