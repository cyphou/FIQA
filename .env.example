# Copy to .env and fill in. NEVER commit .env.
# The assessor requires READ-ONLY scopes. If a value below would grant write
# access, it is misconfigured.

# Entra tenant hosting the Fabric / Power BI estate
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Dedicated service principal used for metadata scanning (read-only)
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=

# API endpoints
FABRIC_API_BASE=https://api.fabric.microsoft.com/v1
POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg

# Collection tuning — defaults respect documented Scanner API quotas
SCANNER_WORKSPACE_BATCH=100
SCANNER_MAX_CONCURRENT_SCANS=16
SCANNER_MODIFIED_SINCE_DAYS=30
COLLECTOR_MAX_RETRIES=5

# Where results are written. A local folder during development, a OneLake
# Files/ path when running inside a Fabric notebook.
LAKEHOUSE_ROOT=./artifacts/lakehouse

# Set to false in a customer environment unless a retention and residency
# decision has been recorded. Bronze holds raw API payloads.
PERSIST_BRONZE_EVIDENCE=true
