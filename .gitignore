# Assessment output — evidence, never source
artifacts/
*.ndjson

# Local lakehouse output
lakehouse_out/
bronze/
silver/
gold/

# Never commit a real tenant inventory. Fixtures live in examples/sample_tenant/.
inventory_*.json
tenant_*.json
!examples/sample_tenant/tenant.json

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling scratch output
.playwright-mcp/

# Generated Power BI (.pbip) project — tenant-derived marts, never source
powerbi_report/
*.pbip
Mart*.csv

# Assessment artifacts, wherever --out points them
*_assessment.json
*_backlog.json
*_backlog.csv
*_readiness.html
*_review.json

# Calibration evidence, wherever --calibration points it. The worksheet carries
# measured tenant metadata; the key carries object names and the tool's verdicts.
*_calibration_worksheet.csv
*_calibration_key.json
*_calibration_instructions.md
*_calibration_agreement.json
*_calibration_disagreements.csv

# Medallion output: layer dirs are already ignored; cover the documented root
# and the actual file extension the writer emits (lakehouse.py writes .jsonl).
/lakehouse/
*.jsonl
!examples/**/*.jsonl

# Live-collection checkpoints: tenant_id + raw Bronze payloads
*checkpoint*.json
*checkpoint*.json.tmp
